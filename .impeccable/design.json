  "components": [
    {
      "name": "Archive Strip",
      "kind": "custom",
      "refersTo": null,
      "description": "홈 전용. 축 헤더(총 편수·범위·최다) 아래에 2018년부터의 월별 편수를 그린 데이터 띠. 빈 달은 칠하지 않고, 모바일에서는 연도 9칸으로 요약한다. 수치는 빌드 시점 계산값.",
      "html": "<div class=\"ds-strip\" role=\"img\" aria-label=\"총 편수의 기록. 월별 글 수.\"><span class=\"ds-strip__bar\" style=\"height:8%\"></span><span class=\"ds-strip__bar\" style=\"height:14%\"></span><span class=\"ds-strip__bar ds-strip__bar--empty\"></span><span class=\"ds-strip__bar\" style=\"height:22%\"></span><span class=\"ds-strip__bar\" style=\"height:9%\"></span><span class=\"ds-strip__bar\" style=\"height:38%\"></span><span class=\"ds-strip__bar\" style=\"height:52%\"></span><span class=\"ds-strip__bar\" style=\"height:71%\"></span><span class=\"ds-strip__bar\" style=\"height:46%\"></span><span class=\"ds-strip__bar\" style=\"height:88%\"></span><span class=\"ds-strip__bar ds-strip__bar--now\" style=\"height:100%\"></span></div>",
      "css": ".ds-strip{display:flex;align-items:flex-end;gap:2px;height:56px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.14);background:#010205;font-family:'Noto Sans KR',sans-serif}.ds-strip__bar{flex:1 1 0;min-height:5px;background:rgba(255,255,255,.42)}.ds-strip__bar--empty{min-height:0;background:transparent}.ds-strip__bar--now{background:#3fa4ff}"
    },
    {
      "name": "Month Ledger Head",
      "kind": "custom",
      "refersTo": null,
      "description": "홈 전용. 스크롤하면 상단에 붙어 지금 보는 달을 알리는 러닝 헤드. 그 달이 페이지에 걸쳐 잘렸으면 두 수를 함께 쓴다.",
      "html": "<h2 class=\"ds-ledger-head\"><span class=\"ds-ledger-head__month\">2026.11</span><span class=\"ds-ledger-head__count\">보이는 수 / 전체 수편</span></h2>",
      "css": ".ds-ledger-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0;padding:10px 0 8px;background:#fff;border-bottom:1px solid #ddd;font-family:'Noto Sans KR',sans-serif;font-size:15px;font-weight:700;line-height:1.4;color:#000}.ds-ledger-head__month{font-variant-numeric:tabular-nums}.ds-ledger-head__count{font-size:12.5px;font-weight:400;color:#555;font-variant-numeric:tabular-nums;white-space:nowrap}"
    },
